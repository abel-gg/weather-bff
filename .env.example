# Every value here is optional — see apps/api/src/config.ts for the defaults.
# Invalid values crash the process at boot rather than on the first request.

# --- API ---------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins allowed to call the BFF. Irrelevant when nginx
# proxies /api same-origin, which is how docker-compose runs it.
CORS_ORIGIN=http://localhost:5173

# --- Cache -------------------------------------------------------------
# Current conditions and the daily forecast arrive in one upstream response, so
# they share one entry governed by the tighter of the two policies.
#
# Not a guess: Open-Meteo stamps "interval": 900 on its payload, so it recomputes
# every 15 minutes. That sets the scale. The value sits below it on purpose —
# served data ages by (time since the provider's last recompute) + this TTL, and
# matching their 15 would both push the worst case to 30 minutes and risk locking
# our refresh cycle onto an unlucky phase of theirs. See apps/api/src/config.ts.
WEATHER_TTL_MS=600000
# How long a value may still be served after it goes stale, while a refresh
# happens in the background. This is the window that keeps the app up during a
# provider outage.
WEATHER_STALE_MS=3600000

# Place names do not move. This cache exists to stop the type-ahead from
# turning every keystroke into an upstream call.
GEOCODING_TTL_MS=86400000
GEOCODING_STALE_MS=604800000

# Hard bound on entries per cache (LRU eviction). An unbounded map is a memory
# leak that only shows up under real traffic.
CACHE_MAX_ENTRIES=5000

# --- Upstream ----------------------------------------------------------
# Deliberately short: failing fast to stale data beats holding a connection
# open and passing the provider's latency straight to the user.
UPSTREAM_TIMEOUT_MS=4000
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Web (build-time, baked into the bundle by Vite) --------------------
# Left empty so the SPA calls /api on its own origin: the Vite dev-server proxy
# in development, nginx in the container.
VITE_API_BASE_URL=
